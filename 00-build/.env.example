# Copy to .env and fill in. .env is gitignored, never commit your key.

# Auth (Agent SDK port): by default the SDK reuses your Claude Code login, so no key
# is needed. To use a metered Anthropic API key (recommended: it gives a hard $ cap
# in the Console), uncomment:
# ANTHROPIC_API_KEY=sk-ant-...

# Model + bounds. These ARE your M5 deliverable, tune and justify them.
CORTEX_MODEL=claude-haiku-4-5  # use a cheap, fast model; a full run is ~cents
CORTEX_MAX_ITERATIONS=8       # loop cap (SDK max_turns): stop + escalate, don't spin
CORTEX_MAX_REVISIONS=2        # critic<->drafter cap: stop the bounce-forever bomb
CORTEX_COST_CAP_USD=0.50      # hard spend cap per run (SDK max_budget_usd + our total)
CORTEX_MAX_QUEUE_ITEMS=10     # commitment cap: max backlog stories queued per run
